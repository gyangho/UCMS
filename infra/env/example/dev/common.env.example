# 2026-07-23: Variables shared by the development WebServer and ShareDB containers.
NODE_ENV=dev
DB_HOST=mysql
# 2026-08-23: MySQL DATETIME columns represent Korean local wall-clock time.
DB_TIMEZONE=+09:00
LANG=C.UTF-8
LC_ALL=C.UTF-8

# 2026-08-19: Use a unique 32-byte-or-longer secret and limit browser WebSocket origins in development.
SHAREDB_AUTH_SECRET=CHANGE_ME_DEV_SHAREDB_AUTH_SECRET
SHAREDB_ALLOWED_ORIGINS=https://dev-ucms.gyangho.com,https://localhost,http://localhost:5173

# 2026-08-19: Enable only when adopting Flyway on an existing 0.0.1 database without schema history.
FLYWAY_BASELINE_ON_MIGRATE=false
