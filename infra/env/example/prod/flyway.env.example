# 2026-08-20: Copy to infra/env/prod/flyway.env and grant this account only the DDL needed for deployment.
# 2026-08-22: MySQL 8 caching_sha2_password requires controlled public-key retrieval on the private Docker network.
FLYWAY_URL=jdbc:mysql://mysql:3306/ucms_prod?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
FLYWAY_USER=CHANGE_ME
FLYWAY_PASSWORD=CHANGE_ME
FLYWAY_LOCATIONS=filesystem:/flyway/sql
FLYWAY_VALIDATE_MIGRATION_NAMING=true
FLYWAY_CONNECT_RETRIES=30
FLYWAY_BASELINE_VERSION=0.0.1
FLYWAY_BASELINE_DESCRIPTION=UCMS schema before Flyway
# 2026-08-20: Set true only for the first adoption on the non-empty 0.0.1 production schema, then restore false.
FLYWAY_BASELINE_ON_MIGRATE=false
