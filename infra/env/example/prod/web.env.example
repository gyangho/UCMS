# 2026-07-23: Production WebServer variables. Never reuse development secrets.
DB_USER=ucms_prod
DB_PASSWORD=CHANGE_ME_PROD_DB_PASSWORD
DB_NAME=ucms_prod

DOMAIN=https://example.com
SESSION_SECRET=CHANGE_ME_WITH_A_DIFFERENT_64_CHARACTER_RANDOM_SECRET

