EMAIL_VERIFICATION_ENABLED=true
SPRING_MAIL_BASE_URL=http://ucms-spring:8080
UCMS_INTERNAL_MAIL_TOKEN=CHANGE_ME_WITH_AN_INDEPENDENT_PRODUCTION_64_CHARACTER_TOKEN

GOOGLE_DRIVE_FOLDER_ID=CHANGE_ME_GOOGLE_DRIVE_FOLDER_ID
