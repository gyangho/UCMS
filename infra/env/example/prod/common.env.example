# 2026-07-23: Variables shared by the production WebServer and ShareDB containers.
NODE_ENV=prod
DB_HOST=mysql
# 2026-08-23: MySQL DATETIME columns represent Korean local wall-clock time.
DB_TIMEZONE=+09:00
LANG=C.UTF-8
LC_ALL=C.UTF-8

# 2026-08-19: Production accepts realtime browser connections only from the Cloudflare-hosted UCMS origin.
SHAREDB_AUTH_SECRET=CHANGE_ME_PROD_SHAREDB_AUTH_SECRET
SHAREDB_ALLOWED_ORIGINS=https://ucms.gyangho.com

# 2026-08-19: Set true only for the first 0.0.1-to-0.1.1 Flyway run, then restore false.
FLYWAY_BASELINE_ON_MIGRATE=false
