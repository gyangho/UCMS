# 2026-07-23: MySQL container bootstrap and healthcheck variables.
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=ucms_dev
MYSQL_USER=ucms_dev
MYSQL_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD

# These values are used by docker-compose.infra.yml's socket healthcheck.
MYSQL_HEALTHCHECK_USER=root
MYSQL_HEALTHCHECK_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
