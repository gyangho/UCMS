server {
    listen 443 ssl;
    http2 on;
    # 2026-08-19: Render the production host and certificate directory from infra/env/infra/ports.env.
    server_name ${NGINX_PROD_HOST};
    # 2026-08-23: Match production upload capacity to the bounded JSON limits enforced by the applications.
    client_max_body_size 16m;

    # SSL
    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 공통 프록시 헤더
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 에러 처리
    proxy_intercept_errors on;
    error_page 502 503 504 = @prod_error_page;

    location @prod_error_page {
        default_type text/html;
        add_header Content-Type "text/html; charset=UTF-8";
        return 200 "
        <html>
            <head><title>Service Unavailable</title></head>
            <body style='text-align:center; padding-top:100px; font-family: sans-serif;'>
                <h1>🚧 서버 점검 중 🚧</h1>
                <p>현재 <b>운영</b> 서버가 가동 중이지 않습니다.</p>
                <p>관리자에게 문의하거나 잠시 후 다시 시도해 주세요.</p>
            </body>
        </html>";
    }

    resolver 127.0.0.11 valid=30s;

    # 2026-08-19: Route JSON APIs and server-side OAuth actions to Express using shared port configuration.
    location = /api {
        # 2026-08-23: Use production-unique container names because Nginx joins dev and prod networks.
        set $upstream "http://prod_ucms_web:${WEB_PORT}";
        proxy_pass $upstream;

        proxy_read_timeout 1800;
        proxy_connect_timeout 60;
        proxy_send_timeout 1800;
    }

    location ^~ /api/ {
        set $upstream "http://prod_ucms_web:${WEB_PORT}";
        proxy_pass $upstream;

        proxy_read_timeout 1800;
        proxy_connect_timeout 60;
        proxy_send_timeout 1800;
    }

    location ~ ^/auth/(authorize|redirect|oauth2callback|logout)$ {
        set $upstream "http://prod_ucms_web:${WEB_PORT}";
        proxy_pass $upstream;

        proxy_read_timeout 1800;
        proxy_connect_timeout 60;
        proxy_send_timeout 1800;
    }

    location = /health {
        set $upstream "http://prod_ucms_web:${WEB_PORT}";
        proxy_pass $upstream;
        proxy_intercept_errors off;
    }

    # [2] WebSocket (ShareDB)
    location /sharedb {
        set $upstream "http://prod_ucms_sharedb:${SHAREDB_PORT}";
        proxy_pass $upstream;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # 2026-08-19: Retire the unauthenticated legacy bot surface until the Kakao Business chatbot API replaces it.
    location = /bot {
        default_type application/json;
        return 410 '{"success":false,"error":{"code":"BOT_RETIRED","message":"Legacy bot API is retired."}}';
    }

    location ^~ /bot/ {
        default_type application/json;
        return 410 '{"success":false,"error":{"code":"BOT_RETIRED","message":"Legacy bot API is retired."}}';
    }

    # 2026-08-19: Serve the production SPA for every remaining route using the shared React port.
    location / {
        set $upstream "http://prod_ucms_react:${REACT_PORT}";
        proxy_pass $upstream;

        proxy_read_timeout 1800;
        proxy_connect_timeout 60;
        proxy_send_timeout 1800;
    }
}
