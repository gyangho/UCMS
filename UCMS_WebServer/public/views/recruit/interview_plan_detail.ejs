<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>UCMS-면접 계획 상세</title>
    <%- include('../header') %>
    <link rel="stylesheet" href="/styles/style.css" />
    <style>
      body {
        margin: 0;
        font-family: "Noto Sans KR", sans-serif;
      }

      .container {
        max-width: 1200px;
        margin: 30px auto;
        padding: 20px;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
      }

      .title {
        font-size: 2rem;
        color: #333;
        margin: 0;
      }

      .btn {
        padding: 12px 24px;
        font-size: 1rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
      }

      .btn-primary {
        background: #667eea;
        color: white;
      }

      .btn-primary:hover {
        background: #5a6fd8;
      }

      .btn-secondary {
        background: #6c757d;
        color: white;
      }

      .btn-secondary:hover {
        background: #5a6268;
      }

      .plan-info-section {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
      }

      .section-title {
        font-size: 1.4rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #667eea;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 20px;
      }

      .info-item {
        display: flex;
        flex-direction: column;
      }

      .info-label {
        font-weight: bold;
        color: #666;
        margin-bottom: 5px;
        font-size: 0.9rem;
      }

      .info-value {
        color: #333;
        font-size: 1.1rem;
      }

      .dates-section {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
      }

      .dates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
      }

      .date-card {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
      }

      .date-label {
        font-weight: bold;
        color: #495057;
        margin-bottom: 8px;
      }

      .date-value {
        color: #667eea;
        font-size: 1.1rem;
        font-weight: bold;
      }

      .interviewers-section {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
      }

      .interviewers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
      }

      .interviewer-card {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
      }

      .interviewer-name {
        font-weight: bold;
        color: #495057;
        margin-bottom: 5px;
      }

      .interviewer-id {
        color: #6c757d;
        font-size: 0.9rem;
      }

      .time-slots-section {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
      }

      .time-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
      }

      .time-table th,
      .time-table td {
        border: 1px solid #b1b1b1;
        padding: 10px;
        text-align: center;
      }

      .time-table th {
        background: #dee5fa;
        font-weight: bold;
        color: #495057;
      }

      .time-slot-available {
        background: #d4edda;
        color: #155724;
        font-weight: bold;
      }

      .time-slot-unavailable {
        background: #f8d7da;
        color: #721c24;
        font-weight: bold;
      }

      .interviewer-time-section {
        margin-bottom: 30px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
      }

      .interviewer-time-title {
        font-size: 1.2rem;
        font-weight: bold;
        color: #495057;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 2px solid #667eea;
      }

      .interviewer-time-section .time-table {
        margin-top: 0;
      }

      .date-cell {
        background-color: #f8f9fa;
        vertical-align: middle;
        border-right: 2px solid #667eea;
      }

      /* 피면접자 섹션 스타일 */
      .interviewees-section {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
      }

      .interviewees-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 15px;
      }

      .interviewee-card {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        transition: all 0.3s ease;
      }

      .interviewee-card:hover {
        border-color: #667eea;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      }

      .interviewee-name {
        font-weight: bold;
        color: #495057;
        margin-bottom: 10px;
        font-size: 1.1rem;
      }

      .interviewee-info {
        color: #666;
        font-size: 0.9rem;
      }

      .interviewee-info > div {
        margin-bottom: 5px;
      }

      .rating-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: bold;
      }

      /* 면접 스케줄 테이블 스타일 */
      .interview-schedule-section {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
      }

      .schedule-table-container {
        overflow-x: auto;
        margin-top: 15px;
      }

      .schedule-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
      }

      .schedule-table th,
      .schedule-table td {
        border: 1px solid #b1b1b1;
        padding: 12px;
        text-align: center;
      }

      .schedule-table th {
        background: #dee5fa;
        font-weight: bold;
        color: #495057;
      }

      .schedule-table tbody tr:nth-child(even) {
        background: #f8f9fa;
      }

      .schedule-table tbody tr:hover {
        background: #e3f2fd;
      }

      .rating-대기 {
        background: #f3f4f6;
        color: #6b7280;
      }

      .rating-1차합격 {
        background: #f0f9ff;
        color: #0369a1;
      }

      .rating-불합격 {
        background: #fef2f2;
        color: #dc2626;
      }

      .rating-느별 {
        background: #fffbeb;
        color: #d97706;
      }

      .rating-느괜 {
        background: #eff6ff;
        color: #2563eb;
      }

      .rating-느좋 {
        background: #f7fdf0;
        color: #64a316;
      }

      .rating-최종합격 {
        background: #f0fdf4;
        color: #047857;
      }

      .back-link {
        color: #667eea;
        text-decoration: none;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }

      .back-link:hover {
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .header {
          flex-direction: column;
          gap: 15px;
          align-items: flex-start;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .dates-grid,
        .interviewers-grid {
          grid-template-columns: 1fr;
        }

        .interviewees-grid {
          grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        }

        .time-table {
          font-size: 0.9rem;
        }

        .time-table th,
        .time-table td {
          padding: 8px 5px;
        }

        /* 휴대폰에서 면접 스케줄 표 최적화 */
        .schedule-table {
          min-width: 350px;
          font-size: 0.8rem;
        }

        .schedule-table th,
        .schedule-table td {
          padding: 6px 4px;
          font-size: 0.8rem;
        }

        .schedule-table th {
          font-size: 0.85rem;
          padding: 8px 4px;
        }
      }

      @media (max-width: 480px) {
        /* 작은 휴대폰에서 추가 최적화 */
        .schedule-table {
          min-width: 280px;
        }

        .schedule-table th,
        .schedule-table td {
          padding: 5px 3px;
          font-size: 0.75rem;
        }

        .schedule-table th {
          font-size: 0.8rem;
          padding: 7px 3px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <div>
          <a href="/recruit/interview/plans" class="back-link"
            >← 면접 계획 목록으로</a
          >
          <h1 class="title">
            <%= plan.title %> <% if (plan.status === 'active') { %>
            <span
              style="
                font-size: 1.2rem;
                color: #28a745;
                margin-left: 15px;
              "
              >✓ 확정됨</span
            >
            <% } else if (plan.status === 'completed') { %>
            <span
              style="
                font-size: 1.2rem;
                color: #007bff;
                margin-left: 15px;
              "
              >✓ 완료됨</span
            >
            <% } %>
          </h1>
        </div>
        <div style="display: flex; align-items: center; gap: 15px">
          <% if (plan.status !== 'active' && plan.status !==
          'completed') { %>
          <div style="display: flex; align-items: center; gap: 8px">
            <label
              for="min-interviewers"
              style="
                font-weight: bold;
                color: #333;
                font-size: 0.9rem;
              "
              >최소 면접관 수:</label
            >
            <input
              type="number"
              id="min-interviewers"
              name="min-interviewers"
              min="1"
              max="10"
              value="2"
              style="
                width: 60px;
                padding: 8px;
                border: 1px solid #ddd;
                border-radius: 4px;
                text-align: center;
              "
            />
          </div>
          <button
            id="generate-timetable-btn"
            class="btn btn-primary"
            style="background: #72cf88"
            onclick="generateInterviewTimetable()"
          >
            면접스케쥴 생성
          </button>
          <a
            href="/recruit/interview/plan/selectform?planId=<%= plan.id %>"
            class="btn btn-primary"
            >편집</a
          >
          <button
            id="confirm-plan-btn"
            class="btn btn-primary"
            style="background: #f97885"
            onclick="confirmInterviewPlan()"
          >
            확정
          </button>
          <% } else if (plan.status === 'active') { %>
          <button
            id="cancel-plan-btn"
            class="btn btn-secondary"
            onclick="cancelInterviewPlan()"
          >
            확정 취소
          </button>
          <button
            id="complete-plan-btn"
            class="btn btn-primary"
            style="background: #007bff"
            onclick="completeInterviewPlan()"
          >
            면접 종료
          </button>
          <% } %>
        </div>
      </div>

      <!-- 기본 정보 섹션 -->
      <div class="plan-info-section">
        <h2 class="section-title">기본 정보</h2>
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">면접 계획 제목</span>
            <span class="info-value"> <%= plan.title %> </span>
          </div>
          <div class="info-item">
            <span class="info-label">연결된 폼</span>
            <span class="info-value">
              <a
                href="https://docs.google.com/forms/d/<%= plan.form_id %>/edit"
                target="_blank"
                style="color: #667eea; text-decoration: none"
              >
                <%= plan.form_title %>
              </a>
            </span>
          </div>
          <div class="info-item">
            <span class="info-label">생성자</span>
            <span class="info-value">
              <%= plan.created_by_name %>
            </span>
          </div>
          <div class="info-item">
            <span class="info-label">최종 수정자</span>
            <span class="info-value">
              <%= plan.updated_by_name %>
            </span>
          </div>
          <div class="info-item">
            <span class="info-label">생성일</span>
            <span class="info-value">
              <%= new
              Date(plan.created_at).toLocaleDateString('ko-KR') %>
            </span>
          </div>
          <div class="info-item">
            <span class="info-label">최종 수정일</span>
            <span class="info-value">
              <%= new
              Date(plan.updated_at).toLocaleDateString('ko-KR') %>
            </span>
          </div>
        </div>
      </div>

      <!-- 면접 날짜 섹션 -->
      <div class="dates-section">
        <h2 class="section-title">면접 날짜</h2>
        <% if (interviewDates && interviewDates.length> 0) { %>
        <div class="dates-grid">
          <% interviewDates.forEach(date=> { %>
          <div class="date-card">
            <div class="date-label">면접 날짜</div>
            <div class="date-value">
              <%= new
              Date(date.interview_date).toLocaleDateString('ko-KR', {
              month: 'long' , day: 'numeric' }) %>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <p style="color: #6c757d; text-align: center">
          등록된 면접 날짜가 없습니다.
        </p>
        <% } %>
      </div>

      <!-- 면접관 섹션 -->
      <div class="interviewers-section">
        <h2 class="section-title">
          면접관 (<%= interviewers ? interviewers.length : 0 %>명)
        </h2>
        <% if (interviewers && interviewers.length> 0) { %>
        <div class="interviewers-grid">
          <% interviewers.forEach(interviewer=> { %>
          <div class="interviewer-card">
            <div class="interviewer-name">
              <%= interviewer.name %>
            </div>
            <div class="interviewer-id"><%= interviewer.id %></div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <p style="color: #6c757d; text-align: center">
          등록된 면접관이 없습니다.
        </p>
        <% } %>
      </div>

      <!-- 면접 시간대 섹션 -->
      <div class="time-slots-section">
        <h2 class="section-title">면접관별 면접 가능 시간</h2>
        <% if (interviewerTimeSlots && interviewerTimeSlots.length> 0)
        { %> <% const timeSlotsByInterviewer={};
        interviewerTimeSlots.forEach(slot=> { const interviewerId =
        slot.interviewer_id; const interviewerName =
        slot.interviewer_name || slot.interviewer_id; if
        (!timeSlotsByInterviewer[interviewerId]) {
        timeSlotsByInterviewer[interviewerId] = { name:
        interviewerName, slots: [] }; }
        timeSlotsByInterviewer[interviewerId].slots.push(slot); }); %>
        <% Object.values(timeSlotsByInterviewer).forEach(interviewer=>
        { %>
        <div class="interviewer-time-section">
          <h3 class="interviewer-time-title">
            <%= interviewer.name %>
          </h3>
          <table class="time-table">
            <thead>
              <tr>
                <th>면접 날짜</th>
                <th>시간대</th>
              </tr>
            </thead>
            <tbody>
              <% const slotsByDate={};
              interviewer.slots.forEach(slot=> { const dateKey =
              slot.interview_date; if (!slotsByDate[dateKey]) {
              slotsByDate[dateKey] = []; }
              slotsByDate[dateKey].push(slot); }); let isFirstRow =
              true; Object.keys(slotsByDate).forEach(dateKey => {
              const slots = slotsByDate[dateKey]; const dateStr = new
              Date(dateKey).toLocaleDateString('ko-KR', { month:
              'long', day: 'numeric' }); const rowspan = slots.length;
              slots.forEach((slot, index) => { if (index === 0) { %>
              <tr>
                <td rowspan="<%= rowspan %>" class="date-cell">
                  <%= dateStr %>
                </td>
                <td><%= slot.time_slot %></td>
              </tr>
              <% } else { // 나머지 행은 날짜 없이 시간대만 표시 %>
              <tr>
                <td><%= slot.time_slot %></td>
              </tr>
              <% } }); }); %>
            </tbody>
          </table>
        </div>
        <% }) %> <% } else { %>
        <p style="color: #6c757d; text-align: center">
          등록된 면접 시간대가 없습니다.
        </p>
        <% } %>
      </div>

      <!-- 피면접자 섹션 -->
      <div class="interviewees-section">
        <h2 class="section-title">
          피면접자 목록 (<%= interviewees ? interviewees.length : 0
          %>명)
        </h2>
        <% if (interviewees && interviewees.length > 0) { %>
        <div class="interviewees-grid">
          <% interviewees.forEach(interviewee => { %>
          <div class="interviewee-card">
            <div class="interviewee-name">
              <%= interviewee.name %>
            </div>
            <div class="interviewee-info">
              <div class="interviewee-student-id">
                학번: <%= interviewee.student_id %>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <p style="color: #6c757d; text-align: center">
          등록된 피면접자가 없습니다.
        </p>
        <% } %>
      </div>

      <!-- 면접 스케줄 섹션 -->
      <div class="interview-schedule-section">
        <h2 class="section-title">
          면접 스케줄 (<%= interviewSchedule ?
          interviewSchedule.length : 0 %>건)
        </h2>
        <% if (interviewSchedule && interviewSchedule.length > 0) { %>
        <div class="schedule-table-container">
          <table class="schedule-table">
            <thead>
              <tr>
                <th>면접 날짜</th>
                <th>시간대</th>
                <th>면접관</th>
                <th>피면접자</th>
                <th>평가</th>
              </tr>
            </thead>
            <tbody>
              <% interviewSchedule.forEach(schedule => { %>
              <tr>
                <td>
                  <% const dateTimeStr = schedule.interview_date;
                  const datePart = dateTimeStr.split(' ')[0]; %> <%=
                  datePart %>
                </td>
                <td>
                  <% const timePart = dateTimeStr.split(' ')[1] ||
                  schedule.time_slot; %> <%= timePart %>
                </td>
                <td>
                  <% schedule.interviewers.forEach((interviewer,
                  index) => { %> <%= interviewer.name %> <% if (index
                  < schedule.interviewers.length - 1) { %>, <% } %> <%
                  }) %>
                </td>
                <td>
                  <% schedule.interviewees.forEach((interviewee,
                  index) => { %> <%= interviewee.name %> <% if (index
                  < schedule.interviewees.length - 1) { %>, <% } %> <%
                  }) %>
                </td>
                <td>
                  <% schedule.interviewees.forEach((interviewee,
                  index) => { %> <% if (interviewee.rating) { %>
                  <span
                    class="rating-badge rating-<%= interviewee.rating %>"
                    ><%= interviewee.rating %></span
                  >
                  <% } else { %>
                  <span class="rating-badge rating-대기">대기</span>
                  <% } %> <% if (index < schedule.interviewees.length
                  - 1) { %>, <% } %> <% }) %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <p style="color: #6c757d; text-align: center">
          생성된 면접 스케줄이 없습니다. 면접 타임테이블을 먼저
          생성해주세요.
        </p>
        <% } %>
      </div>
    </div>

    <script>
      // 페이지 로드 시 면접관 이름 정보 가져오기
      document.addEventListener("DOMContentLoaded", function () {
        // 면접관별 시간대 섹션의 모든 테이블에 대해 처리
        const timeTables = document.querySelectorAll(
          ".interviewer-time-section .time-table"
        );
        timeTables.forEach((table) => {
          const rows = table.querySelectorAll("tbody tr");
          rows.forEach((row) => {
            // 면접관 이름은 이미 섹션 제목에 표시되므로 추가 처리 불필요
            // 필요시 여기에 다른 로직 추가 가능
          });
        });
      });

      // 면접 타임테이블 생성 함수
      function generateInterviewTimetable() {
        const minInterviewers = document.getElementById(
          "min-interviewers"
        ).value;
        const planId = "<%= plan.id %>";
        const generateBtn = document.getElementById(
          "generate-timetable-btn"
        );

        // 입력값 검증
        if (
          !minInterviewers ||
          minInterviewers < 1 ||
          minInterviewers > 10
        ) {
          alert("최소 면접관 수를 1-10 사이의 값으로 입력해주세요.");
          return;
        }

        // 사용자 확인
        if (
          !confirm(
            `최소 ${minInterviewers}명의 면접관으로 면접 타임테이블을 생성하시겠습니까?`
          )
        ) {
          return;
        }

        // 버튼 비활성화 및 로딩 표시
        generateBtn.disabled = true;
        generateBtn.textContent = "생성 중...";
        generateBtn.style.background = "#3f6d4a";

        // 면접 스케줄러 실행 API 호출
        fetch(`/api/interview/scheduler/${planId}/run`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            minInterviewers: parseInt(minInterviewers),
            planId: parseInt(planId),
          }),
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.success) {
              alert("면접 스케줄이 성공적으로 생성되었습니다!");
              // 페이지 새로고침하여 결과 표시
              location.reload();
            } else {
              alert(
                `면접 스케줄 생성 실패: ${
                  data.error || "알 수 없는 오류"
                }`
              );
            }
          })
          .catch((error) => {
            console.error("API 호출 오류:", error);
            alert("면접 스케줄 생성 중 오류가 발생했습니다.");
          })
          .finally(() => {
            // 버튼 상태 복원
            generateBtn.disabled = false;
            generateBtn.textContent = "면접 타임테이블 생성";
            generateBtn.style.background = "#72cf88";
          });
      }

      // 면접 계획 확정 함수
      function confirmInterviewPlan() {
        const planId = "<%= plan.id %>";
        const confirmBtn = document.getElementById(
          "confirm-plan-btn"
        );

        // 사용자 확인
        if (
          !confirm(
            "이 면접 계획을 확정하시겠습니까? 확정 후에는 수정할 수 없습니다."
          )
        ) {
          return;
        }

        // 버튼 비활성화 및 로딩 표시
        confirmBtn.disabled = true;
        confirmBtn.textContent = "확정 중...";
        confirmBtn.style.background = "#6c757d";

        // 면접 계획 확정 API 호출
        fetch(`/api/interview/plans/${planId}/confirm`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.success) {
              alert("면접 계획이 성공적으로 확정되었습니다!");
              // 페이지 새로고침하여 상태 업데이트
              location.reload();
            } else {
              alert(
                `면접 계획 확정 실패: ${
                  data.error || "알 수 없는 오류"
                }`
              );
            }
          })
          .catch((error) => {
            console.error("API 호출 오류:", error);
            alert("면접 계획 확정 중 오류가 발생했습니다.");
          })
          .finally(() => {
            // 버튼 상태 복원
            confirmBtn.disabled = false;
            confirmBtn.textContent = "확정";
            confirmBtn.style.background = "#f97885";
          });
      }

      // 면접 계획 확정 취소 함수
      function cancelInterviewPlan() {
        const planId = "<%= plan.id %>";
        const cancelBtn = document.getElementById("cancel-plan-btn");

        // 사용자 확인
        if (
          !confirm(
            "이 면접 계획의 확정을 취소하시겠습니까? 취소 후에는 다시 편집할 수 있습니다."
          )
        ) {
          return;
        }

        // 버튼 비활성화 및 로딩 표시
        cancelBtn.disabled = true;
        cancelBtn.textContent = "취소 중...";
        cancelBtn.style.background = "#6c757d";

        // 면접 계획 확정 취소 API 호출
        fetch(`/api/interview/plans/${planId}/cancel`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.success) {
              alert("면접 계획 확정이 취소되었습니다!");
              // 페이지 새로고침하여 상태 업데이트
              location.reload();
            } else {
              alert(
                `면접 계획 확정 취소 실패: ${
                  data.error || "알 수 없는 오류"
                }`
              );
            }
          })
          .catch((error) => {
            console.error("API 호출 오류:", error);
            alert("면접 계획 확정 취소 중 오류가 발생했습니다.");
          })
          .finally(() => {
            // 버튼 상태 복원
            cancelBtn.disabled = false;
            cancelBtn.textContent = "확정 취소";
            cancelBtn.style.background = "#6c757d";
          });
      }

      // 면접 종료 함수
      function completeInterviewPlan() {
        const planId = "<%= plan.id %>";
        const completeBtn = document.getElementById(
          "complete-plan-btn"
        );

        // 사용자 확인
        if (
          !confirm(
            "면접을 종료하시겠습니까? 종료 후에는 상태를 변경할 수 없습니다."
          )
        ) {
          return;
        }

        // 버튼 비활성화 및 로딩 표시
        completeBtn.disabled = true;
        completeBtn.textContent = "종료 중...";
        completeBtn.style.background = "#6c757d";

        // 면접 종료 API 호출
        fetch(`/api/interview/plans/${planId}/complete`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.success) {
              alert("면접이 성공적으로 종료되었습니다!");
              // 페이지 새로고침하여 상태 업데이트
              location.reload();
            } else {
              alert(
                `면접 종료 실패: ${data.error || "알 수 없는 오류"}`
              );
            }
          })
          .catch((error) => {
            console.error("API 호출 오류:", error);
            alert("면접 종료 중 오류가 발생했습니다.");
          })
          .finally(() => {
            // 버튼 상태 복원
            completeBtn.disabled = false;
            completeBtn.textContent = "면접 종료";
            completeBtn.style.background = "#007bff";
          });
      }
    </script>
  </body>
</html>
