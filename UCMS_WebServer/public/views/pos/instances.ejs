<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1" />
    <title>UCMS - 인스턴스 목록</title>
    <link rel="stylesheet" href="/styles/pos.css" />
</head>
<%- include('../header') %>

    <body>
        <div class="container" style="flex-direction:column; gap:16px;">
            <div class="header">
                <h1 class="title">인스턴스 관리</h1>
                <button class="btn primary" onclick="location.href='/pos/instances/new'">새 인스턴스 생성</button>
            </div>
            <div class="plans-grid">
                <% (instances || []).forEach(function(ins){ %>
                    <div class="plan-card">
                        <div class="plan-title">
                            <%= ins.instance_name %>
                        </div>
                        <div class="plan-info">ID: <%= ins.id %>
                        </div>
                        <div class="plan-status status-<%= ins.status %>">
                            <%= ins.status %>
                        </div>
                        <div class="plan-actions">
                            <a class="btn btn-small btn-primary" href="/pos/instances/<%= ins.id %>">상세보기</a>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
        <script></script>
    </body>

</html>