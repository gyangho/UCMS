<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>모집 결과 조회 - UCMS</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f5f7fa;
        color: #333;
      }

      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
      }

      .header {
        text-align: center;
        margin-bottom: 40px;
      }

      .header h1 {
        color: #2c3e50;
        font-size: 2.5rem;
        margin-bottom: 10px;
      }

      .header p {
        color: #7f8c8d;
        font-size: 1.1rem;
      }

      .search-section {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 30px;
      }

      .search-form {
        display: flex;
        gap: 15px;
        align-items: center;
        justify-content: center;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .form-group label {
        font-weight: 600;
        color: #2c3e50;
        font-size: 0.9rem;
      }

      .form-group input {
        padding: 12px 16px;
        border: 2px solid #e1e8ed;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s;
        width: 200px;
      }

      .form-group input:focus {
        outline: none;
        border-color: #3498db;
      }

      .search-btn {
        background: #3498db;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s;
        margin-top: 20px;
      }

      .search-btn:hover {
        background: #2980b9;
      }

      .search-btn:disabled {
        background: #bdc3c7;
        cursor: not-allowed;
      }

      .results-section {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        min-height: 200px;
      }

      .results-section h2 {
        color: #2c3e50;
        margin-bottom: 20px;
        text-align: center;
      }

      .no-results {
        text-align: center;
        color: #7f8c8d;
        font-size: 1.1rem;
        padding: 40px 0;
      }

      .result-item {
        border: 1px solid #e1e8ed;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        background: #f8f9fa;
      }

      .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e1e8ed;
      }

      .form-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: #2c3e50;
      }

      .rating-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
        min-width: 80px;
      }

      .rating-passed {
        background: #d4edda;
        color: #155724;
      }

      .rating-failed {
        background: #f8d7da;
        color: #721c24;
      }

      .rating-pending {
        background: #fff3cd;
        color: #856404;
      }

      .result-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
      }

      .detail-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .detail-label {
        font-size: 0.9rem;
        color: #7f8c8d;
        font-weight: 500;
      }

      .detail-value {
        font-size: 1rem;
        color: #2c3e50;
        font-weight: 600;
      }

      .interview-schedule {
        background: #e8f4fd;
        border: 1px solid #bee5eb;
        border-radius: 8px;
        padding: 15px;
        margin-top: 15px;
      }

      .interview-schedule h4 {
        color: #0c5460;
        margin-bottom: 10px;
        font-size: 1rem;
      }

      .schedule-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .error-message {
        background: #f8d7da;
        color: #721c24;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 20px;
      }

      .loading {
        text-align: center;
        color: #7f8c8d;
        padding: 40px 0;
      }

      .spinner {
        border: 3px solid #f3f3f3;
        border-top: 3px solid #3498db;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
        margin: 0 auto 15px;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      /* 면접 장소 섹션 스타일 */
      .interview-place-section {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-top: 30px;
      }

      .interview-place-section h2 {
        color: #2c3e50;
        margin-bottom: 15px;
        text-align: center;
        font-size: 1.4rem;
      }

      .section-description {
        text-align: center;
        color: #7f8c8d;
        margin-bottom: 20px;
        font-size: 0.9rem;
      }

      .place-table-container {
        overflow-x: auto;
      }

      .place-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        min-width: 300px;
        table-layout: fixed;
      }

      .place-table th,
      .place-table td {
        border: 1px solid #e1e8ed;
        padding: 8px 6px;
        text-align: center;
        font-size: 0.85rem;
        line-height: 1.2;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .place-table th:nth-child(1),
      .place-table td:nth-child(1) {
        width: 20%;
      }

      .place-table th:nth-child(2),
      .place-table td:nth-child(2) {
        width: 25%;
      }

      .place-table th:nth-child(3),
      .place-table td:nth-child(3) {
        width: 55%;
      }

      .place-table th {
        background: #3498db;
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 10px 6px;
      }

      .place-table tbody tr:nth-child(even) {
        background: #f8f9fa;
      }

      .place-table tbody tr:hover {
        background: #e3f2fd;
      }

      .place-table td {
        color: #2c3e50;
        font-size: 0.85rem;
      }

      .no-data {
        color: #7f8c8d;
        font-style: italic;
        text-align: center;
      }

      @media (max-width: 768px) {
        .container {
          padding: 15px;
        }

        .search-form {
          flex-direction: column;
          align-items: stretch;
        }

        .form-group input {
          width: 100%;
        }

        .result-details {
          grid-template-columns: 1fr;
        }

        /* 휴대폰에서 면접 장소 표 최적화 */
        .interview-place-section {
          padding: 15px;
          margin-top: 20px;
        }

        .interview-place-section h2 {
          font-size: 1.3rem;
          margin-bottom: 12px;
        }

        .place-table {
          min-width: 250px;
        }

        .place-table th,
        .place-table td {
          padding: 6px 4px;
          font-size: 0.8rem;
        }

        .place-table th {
          font-size: 0.85rem;
          padding: 8px 4px;
        }
      }

      @media (max-width: 480px) {
        /* 작은 휴대폰에서 추가 최적화 */
        .place-table {
          min-width: 200px;
        }

        .place-table th,
        .place-table td {
          padding: 5px 3px;
          font-size: 0.75rem;
        }

        .place-table th {
          font-size: 0.8rem;
          padding: 7px 3px;
        }
      }
    </style>
  </head>

  <%- include('./header') %>

  <body>
    <div class="container">
      <div class="header">
        <h1>모집 결과 조회</h1>
      </div>

      <div class="search-section">
        <form class="search-form" id="searchForm">
          <div class="form-group">
            <label for="studentId">학번</label>
            <input
              type="text"
              id="studentId"
              name="studentId"
              placeholder="학번을 입력하세요"
              required
              maxlength="10"
            />
          </div>
          <button type="submit" class="search-btn" id="searchBtn">
            확인
          </button>
        </form>
      </div>

      <div
        class="results-section"
        id="resultsSection"
        style="display: none"
      >
        <h2>조회 결과</h2>
        <div id="resultsContent"></div>
      </div>

      <!-- 면접 장소 안내 섹션 (1차 합격자용) -->
      <div
        class="interview-place-section"
        id="interviewPlaceSection"
        style="display: none"
      >
        <h2>면접 장소 안내</h2>
        <div class="place-table-container">
          <table class="place-table">
            <thead>
              <tr>
                <th>날짜</th>
                <th>시간</th>
                <th>장소</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof interviewPlaces !== 'undefined' &&
              interviewPlaces.length > 0) { %> <%
              interviewPlaces.forEach(place => { %>
              <tr>
                <td><%= place.date %></td>
                <td><%= place.time %></td>
                <td><%= place.place %></td>
              </tr>
              <% }); %> <% } else { %>
              <tr>
                <td colspan="3" class="no-data">
                  면접 장소 정보가 없습니다.
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <script>
      document
        .getElementById("searchForm")
        .addEventListener("submit", async function (e) {
          e.preventDefault();

          const studentId = document
            .getElementById("studentId")
            .value.trim();
          if (!studentId) {
            alert("학번을 입력해주세요.");
            return;
          }

          // 검색 버튼 비활성화 및 로딩 표시
          const searchBtn = document.getElementById("searchBtn");
          searchBtn.disabled = true;
          searchBtn.textContent = "검색 중...";

          // 결과 섹션 표시
          const resultsSection =
            document.getElementById("resultsSection");
          const resultsContent =
            document.getElementById("resultsContent");

          resultsSection.style.display = "block";
          resultsContent.innerHTML = `
                <div class="loading">
                    <div class="spinner"></div>
                    <p>결과를 조회하고 있습니다...</p>
                </div>
            `;

          try {
            const response = await fetch(
              "/public/recruit_result/search",
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({ studentId }),
              }
            );

            const data = await response.json();

            if (data.success) {
              displayResults(data.results);
            } else {
              displayError(
                data.error || "결과를 조회할 수 없습니다."
              );
            }
          } catch (error) {
            console.error("검색 오류:", error);
            displayError(
              "서버 오류가 발생했습니다. 잠시 후 다시 시도해주세요."
            );
          } finally {
            // 검색 버튼 복원
            searchBtn.disabled = false;
            searchBtn.textContent = "확인";
          }
        });

      function displayResults(results) {
        const resultsContent =
          document.getElementById("resultsContent");
        const interviewPlaceSection = document.getElementById(
          "interviewPlaceSection"
        );

        if (results.length === 0) {
          resultsContent.innerHTML = `
                    <div class="no-results">
                        <p>해당 학번의 지원 정보를 찾을 수 없습니다.</p>
                    </div>
                `;
          interviewPlaceSection.style.display = "none";
          return;
        }

        // 1차 합격자가 있는지 확인
        const hasFirstPass = results.some(
          (result) => result.rating === "1차합격"
        );

        // 면접 장소 섹션 표시/숨김
        if (hasFirstPass) {
          interviewPlaceSection.style.display = "block";
        } else {
          interviewPlaceSection.style.display = "none";
        }

        // 첫 번째 결과에서 이름을 가져와서 환영 메시지로 search-section 내용 변경
        const firstName = results[0].name;
        const searchSection =
          document.querySelector(".search-section");
        searchSection.innerHTML = `
          <div style="text-align: center; padding: 30px;">
            <h2 style="color: #2c3e50; font-size: 1.5rem; margin-bottom: 15px;">
              안녕하세요.
              <br>
              🍞<b>${firstName}</b> 님🍞
            </h2>
            <p style="color: #7f8c8d; font-size: 1.1rem; line-height: 1.6;">
              😊지원해주셔서 감사합니다!🙇‍♂️
            </p>
          </div>
        `;

        let html = "";
        results.forEach((result) => {
          const ratingClass = getRatingClass(result.rating);

          html += `
                    <div class="result-item">
                        <div class="result-header">
                            <div class="form-title">${
                              result.form_title
                            }</div>
                            <div class="rating-badge ${ratingClass}">${
            result.rating
          }</div>
                        </div>
                        <div class="result-details">
                            <div class="detail-item">
                                <div class="detail-label">이름</div>
                                <div class="detail-value">${
                                  result.name
                                }</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">학과</div>
                                <div class="detail-value">${
                                  result.major
                                }</div>
                            </div>
                        </div>
                        ${
                          result.interview_schedule
                            ? `
                            <div class="interview-schedule">
                                <h4>면접 일정</h4>
                                <div class="schedule-info">
                                    <div class="detail-item">
                                        <div class="detail-label">면접 날짜</div>
                                        <div class="detail-value">${result.interview_schedule.interview_date.slice(
                                          0,
                                          5
                                        )}</div>
                                    </div>
                                    <div class="detail-item">
                                        <div class="detail-label">면접 시간</div>
                                        <div class="detail-value">${result.interview_schedule.time_slot.slice(
                                          5
                                        )}</div>
                                    </div>
                                </div>
                            </div>
                        `
                            : ""
                        }
                    </div>
                `;
        });

        resultsContent.innerHTML = html;
      }

      function displayError(message) {
        const resultsContent =
          document.getElementById("resultsContent");
        const interviewPlaceSection = document.getElementById(
          "interviewPlaceSection"
        );

        resultsContent.innerHTML = `
                <div class="error-message">
                    <p>${message}</p>
                </div>
            `;

        // 오류 발생 시 면접 장소 섹션 숨김
        interviewPlaceSection.style.display = "none";

        // search-section을 원래 상태로 복원
        const searchSection =
          document.querySelector(".search-section");
        searchSection.innerHTML = `
          <form class="search-form" id="searchForm">
            <div class="form-group">
              <label for="studentId">학번</label>
              <input
                type="text"
                id="studentId"
                name="studentId"
                placeholder="학번을 입력하세요"
                required
                maxlength="10"
              />
            </div>
            <button type="submit" class="search-btn" id="searchBtn">
              확인
            </button>
          </form>
        `;
      }

      function getRatingClass(rating) {
        switch (rating) {
          case "1차합격":
          case "최종합격":
            return "rating-passed";
          case "불합격":
            return "rating-failed";
          default:
            return "rating-pending";
        }
      }

      function formatDate(dateString) {
        if (!dateString) return "";
        const date = new Date(dateString);
        return date.toLocaleDateString("ko-KR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      }
    </script>
  </body>
</html>
