<!DOCTYPE html>
<html lang="ko">

<head>
  <link rel="icon" href="/images/favicon.png" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UCMS-응답상세정보</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Noto Sans KR', sans-serif;
      background: #f9fafb;
      height: 100vh;
      overflow: hidden;
    }

    .container {
      display: flex;
      height: 100vh;
    }

    .left-panel {
      flex: 1;
      background: white;
      border-right: 1px solid #e5e7eb;
      overflow-y: auto;
      padding: 20px;
      padding-bottom: 60px;
    }

    .right-panel {
      flex: 1;
      background: white;
      overflow-y: auto;
      padding: 20px;
    }

    .panel-header {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #10b981;
      color: #111827;
    }

    .response-item {
      margin-bottom: 20px;
      padding: 15px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: #f9fafb;
    }

    .question {
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
    }

    .answer {
      color: #6b7280;
      line-height: 1.5;
    }

    .member-info {
      background: #eff6ff;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .member-info h3 {
      color: #1e40af;
      margin-bottom: 10px;
    }

    .info-grid {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .info-item {
      display: flex;
      justify-content: space-between;
    }

    .info-label {
      font-weight: 600;
      color: #374151;
    }

    .info-value {
      color: #6b7280;
    }

    .rating-select {
      background: #f3f4f6;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      padding: 4px 8px;
      font-size: 14px;
      color: #374151;
      cursor: pointer;
      transition: border-color 0.2s ease;
    }

    .rating-select:hover {
      border-color: #9ca3af;
    }

    .rating-select:focus {
      outline: none;
      border-color: #10b981;
      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.1);
    }

    /* 평가 값별 배경색 */
    .rating-select[data-current-rating="대기"] {
      background-color: #f3f4f6;
      color: #6b7280;
    }

    .rating-select[data-current-rating="불합격"] {
      background-color: #fef2f2;
      color: #dc2626;
    }

    .rating-select[data-current-rating="느별"] {
      background-color: #fffbeb;
      color: #d97706;
    }

    .rating-select[data-current-rating="느괜"] {
      background-color: #eff6ff;
      color: #2563eb;
    }

    .rating-select[data-current-rating="느좋"] {
      background-color: #f7fdf0;
      color: #64a316;
    }

    .rating-select[data-current-rating="1차합격"] {
      background-color: #f0f9ff;
      color: #0369a1;
    }

    .rating-select[data-current-rating="최종합격"] {
      background-color: #f0fdf4;
      color: #047857;
    }

    /* 드롭다운 옵션 색상 */
    .rating-select option[value="대기"] {
      background-color: #f3f4f6;
      color: #6b7280;
    }

    .rating-select option[value="불합격"] {
      background-color: #fef2f2;
      color: #dc2626;
    }

    .rating-select option[value="느별"] {
      background-color: #fffbeb;
      color: #d97706;
    }

    .rating-select option[value="느괜"] {
      background-color: #eff6ff;
      color: #2563eb;
    }

    .rating-select option[value="느좋"] {
      background-color: #f7fdf0;
      color: #64a316;
    }

    .rating-select option[value="1차합격"] {
      background-color: #f0f9ff;
      color: #0369a1;
    }

    .rating-select option[value="최종합격"] {
      background-color: #f0fdf4;
      color: #047857;
    }
    .rating-select option[value="1차불합격"] {
      background-color: #fef2f2;
      color: #dc2626;
    }

    .shared-doc-container {
      height: calc(100vh - 100px);
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: white;
    }

    .loading {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 200px;
      color: #6b7280;
    }
  </style>
</head>

<body>
<div class="container">
  <!-- 왼쪽 패널: 응답 상세 정보 -->
  <div class="left-panel">
    <div class="panel-header">응답 상세 정보</div>

    <% if (memberInfo) { %>
    <div class="member-info">
      <h3>지원자 정보</h3>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">학번:</span>
          <span class="info-value"><%= memberInfo.student_id || '미입력' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">이름:</span>
          <span class="info-value"><%= memberInfo.name || '미입력' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">학과(부):</span>
          <span class="info-value"><%= memberInfo.major || '미입력' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">전화번호:</span>
          <span class="info-value"><%= memberInfo.phone || '미입력' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">성별:</span>
          <span class="info-value"><%= memberInfo.gender || '미입력' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">평가:</span>
          <select class="rating-select" data-response-id="<%= memberInfo.response_id %>" data-current-rating="<%= memberInfo.rating || '대기' %>">
            <option value="대기" <%= (memberInfo.rating || '대기') === '대기' ? 'selected' : '' %>>대기</option>
            <option value="1차합격" <%= (memberInfo.rating || '대기') === '1차합격' ? 'selected' : '' %>>1차합격</option>
            <option value="불합격" <%= (memberInfo.rating || '대기') === '불합격' ? 'selected' : '' %>>불합격</option>
            <option value="느별" <%= (memberInfo.rating || '대기') === '느별' ? 'selected' : '' %>>느별</option>
            <option value="느괜" <%= (memberInfo.rating || '대기') === '느괜' ? 'selected' : '' %>>느괜</option>
            <option value="느좋" <%= (memberInfo.rating || '대기') === '느좋' ? 'selected' : '' %>>느좋</option>
            <option value="최종합격" <%= (memberInfo.rating || '대기') === '최종합격' ? 'selected' : '' %>>최종합격</option>
            <option value="1차불합격" <%= (memberInfo.rating || '대기') === '1차불합격' ? 'selected' : '' %>>1차불합격</option>
          </select>
        </div>
      </div>
    </div>
    <% } %>

    <% if (responses && responses.length > 0) { %>
    <% responses.forEach(response => { %>
    <div class="response-item">
      <div class="question"><%= response.question %></div>
      <div class="answer"><%= response.answer || '응답 없음' %></div>
    </div>
    <% }) %>
    <% } else { %>
    <div class="loading">응답 데이터를 불러오는 중...</div>
    <% } %>
  </div>

  <!-- 오른쪽 패널: 공유 문서 -->
  <div class="right-panel">
    <div class="panel-header">평가 노트</div>
    <div class="shared-doc-container" id="shared-doc">
      <div class="loading">공유 문서를 불러오는 중...</div>
    </div>
  </div>
</div>

<!-- 완전히 새로운 공유문서 시스템 -->
<script>
  const docId = 'response-<%= responseId %>';
  const formId = '<%= formId %>';
  let socket = null;
  let editor = null;
  let currentVersion = 1;
  let isUpdating = false;
  let currentLine = 0; // 현재 편집 중인 줄 번호
  let previousLine = 0; // 이전 줄 번호
  let lockedLines = new Map(); // lineNumber -> {clientId, lockedAt}
  let myLockedLines = new Set(); // 내가 락한 줄들

  function initEditor() {
    const container = document.getElementById('shared-doc');
    container.innerHTML = '';

    // 텍스트 에디터 생성
    editor = document.createElement('textarea');
    editor.style.width = '100%';
    editor.style.height = '100%';
    editor.style.border = 'none';
    editor.style.resize = 'none';
    editor.style.fontFamily = 'monospace';
    editor.style.fontSize = '14px';
    editor.style.padding = '15px';
    editor.style.outline = 'none';
    editor.placeholder = '평가 노트를 작성해주세요...\n\n💡 사용법:\n- 더블클릭: 줄 편집 권한 요청\n- 줄 이동 시: 이전 줄 락 자동 해제\n- Enter/Backspace/Delete: 자동 전체 동기화\n- 1초간 입력 없으면: 서버에서 최신 문서 요청';

    // WebSocket 연결
    connectWebSocket();

    // 줄별 편집 시스템
    let lastValue = '';
    let inputTimeout = null;
    let refreshTimeout = null; // 문서 새로고침용 타이머
    
    editor.addEventListener('click', function(e) {
      updateCurrentLine();
      checkLineChange();
    });
    
    editor.addEventListener('keyup', function(e) {
      updateCurrentLine();
      checkLineChange();
    });
    
    // 키보드 이벤트 처리
    editor.addEventListener('keydown', function(e) {
      // 화살표 키, Home, End 키 등으로 커서 이동 시
      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) {
        // 키 이벤트 후 줄 번호 업데이트
        setTimeout(() => {
          updateCurrentLine();
          checkLineChange();
        }, 10);
      }
      
      // Enter 키로 새 줄 추가 감지
      if (e.key === 'Enter') {
        // 새 줄 추가 시 즉시 전체 업데이트
        setTimeout(() => {
          const newValue = editor.value;
          sendFullUpdate(newValue);
          lastValue = newValue;
        }, 10);
      }
      
      // Backspace나 Delete 키로 개행 삭제 감지
      if (e.key === 'Backspace' || e.key === 'Delete') {
        const cursorPos = editor.selectionStart;
        const textBeforeCursor = editor.value.substring(0, cursorPos);
        const textAfterCursor = editor.value.substring(cursorPos);
        
        // 개행 문자가 삭제되는지 확인
        const willDeleteNewline = e.key === 'Backspace' 
          ? textBeforeCursor.endsWith('\n')
          : textAfterCursor.startsWith('\n');
          
        if (willDeleteNewline) {
          // 개행 삭제 시 즉시 전체 업데이트
          setTimeout(() => {
            const newValue = editor.value;
            sendFullUpdate(newValue);
            lastValue = newValue;
          }, 10);
        }
      }
    });
    
    // 줄별 락 요청 (더블클릭)
    editor.addEventListener('dblclick', function(e) {
      requestLineLock(currentLine);
    });
    
    // 포커스 아웃 시 모든 락 해제
    editor.addEventListener('blur', function(e) {
      myLockedLines.forEach(lineNumber => {
        releaseLineLock(lineNumber);
      });
    });
    
    // 입력 감지
    editor.addEventListener('input', function(e) {
      if (isUpdating) return;
      
      const currentValue = editor.value;
      const oldValue = lastValue;
      updateCurrentLine();
      
      // 현재 줄이 락되어 있는지 확인
      if (!myLockedLines.has(currentLine)) {
        requestLineLock(currentLine);
        return;
      }
      
      // 디바운스 적용 (0.5초 대기)
      clearTimeout(inputTimeout);
      inputTimeout = setTimeout(() => {
        if (currentValue !== lastValue) {
          // 줄 수가 변경되었는지 확인 (줄 삭제/추가)
          const oldLines = oldValue ? oldValue.split('\n') : [];
          const newLines = currentValue.split('\n');
          
          // 줄 수 변경 또는 개행 문자 변경 감지
          const hasLineCountChange = oldLines.length !== newLines.length;
          const hasNewlineChange = (oldValue || '').includes('\n') !== currentValue.includes('\n');
          
          if (hasLineCountChange || hasNewlineChange) {
            sendFullUpdate(currentValue);
          } else {
            sendLineUpdate(currentLine, currentValue);
          }
          
          lastValue = currentValue;
        }
      }, 500);
      
      // 1초 후 문서 새로고침 타이머 설정
      clearTimeout(refreshTimeout);
      refreshTimeout = setTimeout(() => {
        requestLatestDocument();
      }, 1000);
    });

    container.appendChild(editor);
    
    // 연결 상태 주기적 확인
    setInterval(() => {
      if (socket) {
        const state = socket.readyState;
        const stateText = {
          0: 'CONNECTING',
          1: 'OPEN',
          2: 'CLOSING',
          3: 'CLOSED'
        }[state] || 'UNKNOWN';
        
        console.log(`🔍 WebSocket 상태: ${stateText}`);
      } else {
        console.log('❌ WebSocket 연결이 없습니다');
      }
    }, 30000); // 30초마다 확인
  }

  // 현재 줄 번호 업데이트
  function updateCurrentLine() {
    if (!editor) return;
    const cursorPos = editor.selectionStart;
    const textBeforeCursor = editor.value.substring(0, cursorPos);
    currentLine = (textBeforeCursor.match(/\n/g) || []).length;
  }
  
  // 줄 변경 감지 및 이전 줄 락 해제
  function checkLineChange() {
    if (currentLine !== previousLine) {
      // 이전 줄이 내가 락한 줄이면 해제
      if (myLockedLines.has(previousLine)) {
        releaseLineLock(previousLine);
      }
      
      // 현재 줄이 이미 락되어 있지 않으면 자동으로 락 요청
      if (!myLockedLines.has(currentLine) && !lockedLines.has(currentLine)) {
        requestLineLock(currentLine);
      }
      
      previousLine = currentLine;
    }
  }
  
  // 줄 락 요청
  function requestLineLock(lineNumber) {
    if (socket && socket.readyState === WebSocket.OPEN) {
      const message = {
        type: 'lock-line',
        docId: docId,
        formId: formId,
        lineNumber: lineNumber,
        timestamp: Date.now(),
        clientId: generateClientId()
      };
      
      socket.send(JSON.stringify(message));
    }
  }
  
  // 줄 락 해제
  function releaseLineLock(lineNumber) {
    if (socket && socket.readyState === WebSocket.OPEN) {
      const message = {
        type: 'unlock-line',
        docId: docId,
        formId: formId,
        lineNumber: lineNumber,
        timestamp: Date.now(),
        clientId: generateClientId()
      };
      
      socket.send(JSON.stringify(message));
    }
  }
  
  // 줄별 업데이트 전송
  function sendLineUpdate(lineNumber, content) {
    if (socket && socket.readyState === WebSocket.OPEN) {
      const lines = content.split('\n');
      const lineContent = lines[lineNumber] || '';
      
      const message = {
        type: 'update-line',
        docId: docId,
        formId: formId,
        lineNumber: lineNumber,
        content: lineContent, // 빈 문자열도 포함
        version: currentVersion + 1,
        timestamp: Date.now(),
        clientId: generateClientId()
      };
      
      socket.send(JSON.stringify(message));
      currentVersion++;
    }
  }
  
  // 전체 문서 업데이트 전송 (줄 수 변경 시)
  function sendFullUpdate(content) {
    if (socket && socket.readyState === WebSocket.OPEN) {
      const message = {
        type: 'update',
        docId: docId,
        formId: formId,
        content: content,
        version: currentVersion + 1,
        timestamp: Date.now(),
        clientId: generateClientId()
      };
      
      socket.send(JSON.stringify(message));
      currentVersion++;
    }
  }
  
  // 서버에서 최신 문서 요청
  function requestLatestDocument() {
    if (socket && socket.readyState === WebSocket.OPEN) {
      const message = {
        type: 'get',
        docId: docId,
        formId: formId
      };
      
      socket.send(JSON.stringify(message));
      
      // 요청 후 잠시 대기하여 서버 응답을 받을 시간을 줌
      setTimeout(() => {
        if (editor && editor.value) {
          lastValue = editor.value;
        }
      }, 100);
    }
  }

  // 클라이언트 ID 생성
  function generateClientId() {
    if (!window.clientId) {
      const sessionId = sessionStorage.getItem('ucms_client_id');
      if (sessionId) {
        window.clientId = sessionId;
      } else {
        const newId = 'client_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
        sessionStorage.setItem('ucms_client_id', newId);
        window.clientId = newId;
      }
    }
    return window.clientId;
  }

  function connectWebSocket() {
    // nginx를 통한 WebSocket 연결
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const host = window.location.hostname;
    const wsUrl = `${protocol}//${host}/sharedb`;

    console.log('🔌 WebSocket 연결 시도:', wsUrl);
    socket = new WebSocket(wsUrl);

    socket.onopen = function() {
      console.log('✅ WebSocket 연결됨');
      console.log('📋 문서 ID:', docId);
      console.log('📋 폼 ID:', formId);
      
      // 문서 구독
      const subscribeMessage = {
        type: 'subscribe',
        docId: docId,
        formId: formId
      };
      socket.send(JSON.stringify(subscribeMessage));
      
      // 문서 내용 요청
      const getMessage = {
        type: 'get',
        docId: docId,
        formId: formId
      };
      socket.send(JSON.stringify(getMessage));
      console.log('📤 문서 요청 전송');
    };

    socket.onclose = function(event) {
      console.log('❌ WebSocket 연결 해제');
      console.log('🔄 3초 후 재연결 시도...');
      setTimeout(connectWebSocket, 3000);
    };

    socket.onmessage = function(event) {
      const data = JSON.parse(event.data);
      
      switch (data.type) {
        case 'doc':
          // 초기 문서 내용 설정
          if (data.docId === docId) {
            isUpdating = true;
            currentVersion = data.version || 1;
            editor.value = data.content || '';
            lastValue = editor.value; // lastValue 동기화
            isUpdating = false;
          }
          break;
          
        case 'update':
          // 다른 클라이언트의 전체 문서 업데이트
          if (data.docId === docId && data.clientId !== generateClientId()) {
            isUpdating = true;
            editor.value = data.content;
            lastValue = data.content; // lastValue 동기화
            currentVersion = data.version;
            isUpdating = false;
          }
          break;
          
        case 'line-updated':
          // 다른 클라이언트의 줄별 업데이트
          if (data.docId === docId && data.clientId !== generateClientId()) {
            isUpdating = true;
            const lines = editor.value.split('\n');
            
            lines[data.lineNumber] = data.content;
            editor.value = lines.join('\n');
            lastValue = editor.value; // lastValue 동기화
            currentVersion = data.version;
            isUpdating = false;
          }
          break;
          
        case 'lock-success':
          // 락 획득 성공
          if (data.docId === docId) {
            myLockedLines.add(data.lineNumber);
            lockedLines.set(data.lineNumber, {
              clientId: data.clientId,
              lockedAt: Date.now()
            });
            showNotification(data.message, 'success');
          }
          break;
          
        case 'lock-failed':
          // 락 획득 실패
          if (data.docId === docId) {
            showNotification(data.message, 'warning');
            
            // 락 실패 시 서버에서 최신 문서 요청
            requestLatestDocument();
          }
          break;
          
        case 'unlock-success':
          // 락 해제 성공
          if (data.docId === docId) {
            myLockedLines.delete(data.lineNumber);
            lockedLines.delete(data.lineNumber);
            showNotification(data.message, 'info');
          }
          break;
          
        case 'lock-status':
          // 다른 클라이언트의 락 상태 변경
          if (data.docId === docId && data.clientId !== generateClientId()) {
            if (data.status === 'locked') {
              lockedLines.set(data.lineNumber, {
                clientId: data.clientId,
                lockedAt: Date.now()
              });
            } else if (data.status === 'unlocked') {
              lockedLines.delete(data.lineNumber);
            }
          }
          break;
          
        case 'update-failed':
          // 줄 업데이트 실패
          if (data.docId === docId) {
            showNotification(data.message, 'warning');
            
            // 업데이트 실패 시 서버에서 최신 문서 요청
            requestLatestDocument();
          }
          break;
          
        case 'conflict':
          // 버전 충돌 해결
          if (data.docId === docId) {
            isUpdating = true;
            editor.value = data.content;
            currentVersion = data.version;
            isUpdating = false;
            showNotification(data.message, 'warning');
          }
          break;
      }
    };

    socket.onerror = function(error) {
      console.error('❌ WebSocket 오류:', error);
    };
  }


  
  // 알림 표시 함수
  function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.textContent = message;
    const colors = {
      'success': '#10b981',
      'warning': '#f59e0b',
      'error': '#ef4444',
      'info': '#3b82f6'
    };
    
    notification.style.cssText = `
      position: fixed;
      top: 20px;
      right: 20px;
      background: ${colors[type] || colors.info};
      color: white;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 14px;
      z-index: 1000;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      animation: slideIn 0.3s ease-out;
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
      notification.style.animation = 'slideOut 0.3s ease-in';
      setTimeout(() => notification.remove(), 300);
    }, 3000);
  }

  // CSS 애니메이션 추가
  const style = document.createElement('style');
  style.textContent = `
    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes slideOut {
      from { transform: translateX(0); opacity: 1; }
      to { transform: translateX(100%); opacity: 0; }
    }
  `;
  document.head.appendChild(style);

  // 에디터 초기화
  initEditor();
  
  // 페이지 떠날 때 모든 락 해제
  window.addEventListener('beforeunload', function() {
    myLockedLines.forEach(lineNumber => {
      releaseLineLock(lineNumber);
    });
  });

  // 평가 select 변경 시 DB 업데이트
  document.addEventListener('DOMContentLoaded', function() {
    const ratingSelect = document.querySelector('.rating-select');

    if (ratingSelect) {
      ratingSelect.addEventListener('change', async function() {
        const responseId = this.getAttribute('data-response-id');
        const newRating = this.value;
        const currentRating = this.getAttribute('data-current-rating');

        // 현재 값과 같으면 업데이트하지 않음
        if (newRating === currentRating) {
          return;
        }

        try {
          const response = await fetch('/api/recruit/update-rating', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              form_id: formId,
              response_id: responseId,
              rating: newRating,
            })
          });

          if (response.ok) {
            // 성공 시 현재 값 업데이트
            this.setAttribute('data-current-rating', newRating);
            console.log('평가 업데이트 성공:', newRating);

            // 성공 메시지 표시 (선택사항)
            const successMessage = document.createElement('div');
            successMessage.textContent = '평가가 업데이트되었습니다.';
            successMessage.style.cssText = `
              position: fixed;
              top: 20px;
              right: 20px;
              background: #10b981;
              color: white;
              padding: 10px 15px;
              border-radius: 4px;
              font-size: 14px;
              z-index: 1000;
              animation: fadeInOut 3s ease-in-out;
            `;
            document.body.appendChild(successMessage);

            // 3초 후 메시지 제거
            setTimeout(() => {
              successMessage.remove();
            }, 3000);
          } else {
            // 실패 시 원래 값으로 되돌리기
            this.value = currentRating;
            console.error('평가 업데이트 실패');
            alert('평가 업데이트에 실패했습니다.');
          }
        } catch (error) {
          // 에러 시 원래 값으로 되돌리기
          this.value = currentRating;
          console.error('평가 업데이트 중 오류:', error);
          alert('평가 업데이트 중 오류가 발생했습니다.');
        }
      });
    }
  });

  // 성공 메시지 애니메이션
  const style2 = document.createElement('style');
  style2.textContent = `
    @keyframes fadeInOut {
      0% { opacity: 0; transform: translateY(-10px); }
      10% { opacity: 1; transform: translateY(0); }
      90% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(-10px); }
    }
  `;
  document.head.appendChild(style2);
</script>
</body>

</html>